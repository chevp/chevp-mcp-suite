{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.chevp-mcp-suite.dev/mcp/cryo-po.schema.json",
  "title": "cryo-po-mcp communication channel",
  "description": "Valid inbound MCPMessages for the 'cryo-po' MCP server: who may send them (`from`) and which of this server's tools they may invoke (`payload.action`). Extends the shared envelope in ./_envelope.schema.json.",
  "allOf": [
    {
      "$ref": "./_envelope.schema.json"
    },
    {
      "properties": {
        "to": {
          "oneOf": [
            {
              "const": "cryo-po"
            },
            {
              "type": "array",
              "items": {
                "$ref": "./roles.schema.json#/definitions/MCPRole"
              },
              "contains": {
                "const": "cryo-po"
              }
            }
          ]
        },
        "from": {
          "enum": [
            "cryo-architect",
            "cryo-ba",
            "product",
            "standards"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "manage_backlog",
                "plan_sprint",
                "accept_feature",
                "request_estimate",
                "report_to_product"
              ]
            }
          },
          "required": [
            "action",
            "parameters"
          ]
        }
      }
    }
  ]
}
