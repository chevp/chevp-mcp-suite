{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.chevp-mcp-suite.dev/mcp/nuna-ba.schema.json",
  "title": "nuna-ba-mcp communication channel",
  "description": "Valid inbound MCPMessages for the 'nuna-ba' MCP server: who may send them (`from`) and which of this server's tools they may invoke (`payload.action`). Extends the shared envelope in ./_envelope.schema.json.",
  "allOf": [
    {
      "$ref": "./_envelope.schema.json"
    },
    {
      "properties": {
        "to": {
          "oneOf": [
            {
              "const": "nuna-ba"
            },
            {
              "type": "array",
              "items": {
                "$ref": "./roles.schema.json#/definitions/MCPRole"
              },
              "contains": {
                "const": "nuna-ba"
              }
            }
          ]
        },
        "from": {
          "enum": [
            "nuna-architect",
            "nuna-po"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "write_user_story",
                "define_acceptance_criteria",
                "analyze_requirements",
                "identify_dependencies",
                "validate_completeness"
              ]
            }
          },
          "required": [
            "action",
            "parameters"
          ]
        }
      }
    }
  ]
}
